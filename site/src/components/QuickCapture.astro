---
import { QuickViewDemo } from "../demo/QuickViewDemo";
---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <div class="grid gap-12 items-center md:grid-cols-2">
      <!-- Text -->
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-white mb-4">
          Capture in a flash
        </h2>
        <p class="text-gray-400 leading-relaxed mb-4">
          Hit a global shortcut from anywhere and a tiny input appears.
          Pick a stack, type a thought, press Enter. Gone in under two seconds.
        </p>
        <p class="text-gray-400 leading-relaxed">
          No window switching, no app hunting.
          The thought lands where it belongs and you're back to what you were doing.
        </p>
        <div class="mt-6 flex items-center gap-2">
          <kbd class="rounded border border-gray-600 bg-gray-800 px-2 py-0.5 text-xs font-mono text-gray-300">Ctrl</kbd>
          <span class="text-gray-500">+</span>
          <kbd class="rounded border border-gray-600 bg-gray-800 px-2 py-0.5 text-xs font-mono text-gray-300">Alt</kbd>
          <span class="text-gray-500">+</span>
          <kbd class="rounded border border-gray-600 bg-gray-800 px-2 py-0.5 text-xs font-mono text-gray-300">N</kbd>
          <span class="ml-2 text-sm text-gray-500">from anywhere on your desktop</span>
        </div>
      </div>

      <!-- Live demo -->
      <div>
        <div class="demo-quick-outer">
          <QuickViewDemo client:visible />
        </div>
        <p class="mt-3 text-xs text-gray-500 italic text-center">
          Try typing something and pressing Enter.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .demo-quick-outer {
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.45),
      0 0 30px rgba(123, 220, 181, 0.03);
  }

  .demo-quick-outer :global(.demo-quick-view) {
    width: 100%;
  }
</style>
