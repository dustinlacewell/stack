---
import { StackViewDemo } from "../demo/StackViewDemo";
---

<section class="relative overflow-hidden pt-20 pb-8 sm:pt-28 sm:pb-12">
  <!-- Ambient glow -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 70% 50% at 50% 20%, rgba(123,220,181,0.06) 0%, transparent 100%)"
  >
  </div>

  <div class="mx-auto max-w-5xl px-6 text-center">
    <!-- Logo dot + name -->
    <div class="mb-6 flex items-center justify-center gap-3">
      <span
        class="inline-block h-3 w-3 rounded-full bg-mint-300"
        style="box-shadow: 0 0 12px rgba(123,220,181,0.6)"
      ></span>
      <h1
        class="text-5xl font-bold tracking-tight text-white sm:text-6xl"
      >
        Stack
      </h1>
    </div>

    <p class="mx-auto mb-3 text-xl text-mint-300/80 font-medium italic">
      Throw it on the pile.
    </p>

    <p class="mx-auto mb-12 max-w-lg text-base text-gray-400 leading-relaxed sm:text-lg">
      A fast, keyboard-driven task manager that stays out of your way.
      Nested tasks, daily habits, global shortcuts&mdash;all in a lightweight desktop app.
    </p>

    <!-- Live demo -->
    <div class="mx-auto max-w-2xl">
      <div class="demo-window-outer">
        <StackViewDemo client:load />
      </div>
      <p class="mt-3 text-xs text-gray-500 italic">
        This is the real app — go ahead, click around.
      </p>
    </div>
  </div>
</section>

<style>
  .demo-window-outer {
    border-radius: 14px;
    overflow: hidden;
    height: 360px;
    box-shadow:
      0 18px 60px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(123, 220, 181, 0.04);
  }

  .demo-window-outer :global(.demo-stack-view) {
    height: 100%;
  }
</style>
